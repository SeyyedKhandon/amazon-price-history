{
  "name": "toolbox-for-amazon",
  "version": "1.1.1",
  "private": true,
  "description": "Chrome extension: see several Amazon search pages at once, filter and sort them, and jump to price history.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "package": "npm run typecheck && npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2"
  }
}
